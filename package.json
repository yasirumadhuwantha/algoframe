{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --packages=external --outfile=dist/server.js --format=esm",
    "start": "node scripts/start.mjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:engine": "python -m python_engine.run_tests",
    "test:workflow": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:smoke": "python -m unittest discover -s tests/integration -p test_server.py",
    "test": "npm run test:engine && npm run test:workflow",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:smoke",
    "chat:backup": "python scripts/chat_backup.py"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
